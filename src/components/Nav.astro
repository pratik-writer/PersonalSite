---
const navLinks = [
  { href: "#about", label: "About" },
  { href: "#graph", label: "Graph" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<nav id="nav" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
    <a href="#" class="text-sm font-semibold tracking-tight text-[var(--color-text)]">
      Pratik Pokharel
    </a>
    <div class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
        >
          {link.label}
        </a>
      ))}
    </div>
    <button
      id="menu-toggle"
      class="flex items-center md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="fixed inset-0 z-50 hidden flex-col items-center justify-center bg-[var(--color-bg)]">
  <button
    id="menu-close"
    class="absolute top-5 right-6"
    aria-label="Close menu"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </svg>
  </button>
  <div class="flex flex-col items-center gap-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-link text-lg text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
      >
        {link.label}
      </a>
    ))}
  </div>
</div>

<script>
  const nav = document.getElementById("nav")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const close = document.getElementById("menu-close")!;

  let scrolled = false;
  window.addEventListener("scroll", () => {
    const isScrolled = window.scrollY > 50;
    if (isScrolled !== scrolled) {
      scrolled = isScrolled;
      nav.classList.toggle("bg-[var(--color-bg)]/95", scrolled);
      nav.classList.toggle("backdrop-blur-sm", scrolled);
      nav.classList.toggle("shadow-[0_1px_0_var(--color-border)]", scrolled);
    }
  });

  toggle.addEventListener("click", () => {
    menu.classList.remove("hidden");
    menu.classList.add("flex");
    document.body.style.overflow = "hidden";
  });

  const closeMenu = () => {
    menu.classList.add("hidden");
    menu.classList.remove("flex");
    document.body.style.overflow = "";
  };

  close.addEventListener("click", closeMenu);
  menu.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
