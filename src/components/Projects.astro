---
import projects from "../data/projects.json";
---

<section id="projects" class="reveal px-6 py-24 md:py-32">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-2xl font-semibold tracking-tight">Projects</h2>
    <div class="mt-10 space-y-10">
      {projects.map((project) => (
        <a
          href={project.url}
          class="group block"
          target="_blank"
          rel="noopener noreferrer"
        >
          <h3 class="text-lg font-medium transition-colors group-hover:text-[var(--color-accent)]">
            {project.title}
            <span class="ml-2 inline-block opacity-0 transition-all group-hover:translate-x-1 group-hover:opacity-100">
              &rarr;
            </span>
          </h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-[var(--color-muted)]">
            {project.description}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="text-xs text-[var(--color-muted)] opacity-60">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
