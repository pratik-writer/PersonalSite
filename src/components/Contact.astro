---
---

<section id="contact" class="reveal px-6 py-24 md:py-32">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-2xl font-semibold tracking-tight">Get in touch</h2>
    <p class="mt-3 text-[var(--color-muted)]">
      Have a project in mind, a question, or just want to say hello?
    </p>
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="mt-10 space-y-6"
    >
      <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY" />
      <input type="hidden" name="subject" value="New message from personal site" />
      <input type="checkbox" name="botcheck" class="hidden" />
      <div>
        <label for="name" class="text-sm font-medium">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="mt-2 block w-full border-b border-[var(--color-border)] bg-transparent py-2 text-[0.9375rem] outline-none transition-colors placeholder:text-[var(--color-muted)]/50 focus:border-[var(--color-text)]"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="email" class="text-sm font-medium">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="mt-2 block w-full border-b border-[var(--color-border)] bg-transparent py-2 text-[0.9375rem] outline-none transition-colors placeholder:text-[var(--color-muted)]/50 focus:border-[var(--color-text)]"
          placeholder="you@example.com"
        />
      </div>
      <div>
        <label for="message" class="text-sm font-medium">Message</label>
        <textarea
          id="message"
          name="message"
          rows={4}
          required
          class="mt-2 block w-full resize-none border-b border-[var(--color-border)] bg-transparent py-2 text-[0.9375rem] outline-none transition-colors placeholder:text-[var(--color-muted)]/50 focus:border-[var(--color-text)]"
          placeholder="What's on your mind?"
        ></textarea>
      </div>
      <button
        type="submit"
        class="inline-flex items-center gap-2 border border-[var(--color-text)] px-6 py-2.5 text-sm font-medium transition-colors hover:bg-[var(--color-text)] hover:text-white"
      >
        Send message
      </button>
    </form>
    <div class="mt-16 flex gap-6">
      <a
        href="https://github.com/pratik-writer"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
        aria-label="GitHub profile"
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/pratik-pokharel14"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
        aria-label="LinkedIn profile"
      >
        LinkedIn
      </a>
      <a
        href="mailto:pratikpokhrel14@gmail.com"
        class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
      >
        Email
      </a>
    </div>
  </div>
</section>
