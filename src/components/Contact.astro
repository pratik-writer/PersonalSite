---
---

<section id="contact" class="reveal px-6 py-14 md:py-20">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-2xl font-semibold tracking-tight">Get in touch</h2>
    <p class="mt-3 text-[var(--color-muted)]">
      Have a project in mind, a question, or just want to say hello?
    </p>
    <form
      id="contact-form"
      class="mt-10 space-y-6"
    >
      <input type="checkbox" name="botcheck" class="hidden" />
      <div>
        <label for="name" class="text-sm font-medium">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="mt-2 block w-full border-b border-[var(--color-border)] bg-transparent py-2 text-[0.9375rem] outline-none transition-colors placeholder:text-[var(--color-muted)]/50 focus:border-[var(--color-text)]"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="email" class="text-sm font-medium">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="mt-2 block w-full border-b border-[var(--color-border)] bg-transparent py-2 text-[0.9375rem] outline-none transition-colors placeholder:text-[var(--color-muted)]/50 focus:border-[var(--color-text)]"
          placeholder="you@example.com"
        />
      </div>
      <div>
        <label for="message" class="text-sm font-medium">Message</label>
        <textarea
          id="message"
          name="message"
          rows={4}
          required
          class="mt-2 block w-full resize-none border-b border-[var(--color-border)] bg-transparent py-2 text-[0.9375rem] outline-none transition-colors placeholder:text-[var(--color-muted)]/50 focus:border-[var(--color-text)]"
          placeholder="What's on your mind?"
        ></textarea>
      </div>
      <button
        type="submit"
        id="submit-btn"
        class="inline-flex items-center gap-2 border border-[var(--color-text)] px-6 py-2.5 text-sm font-medium transition-colors hover:bg-[var(--color-text)] hover:text-white"
      >
        Send message
      </button>
      <p id="form-status" class="text-sm hidden"></p>
    </form>
    <div class="mt-16 flex gap-6">
      <a
        href="https://github.com/pratik-writer"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
        aria-label="GitHub profile"
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/pratik-pokharel14"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
        aria-label="LinkedIn profile"
      >
        LinkedIn
      </a>
      <a
        href="mailto:pratikpokhrel14@gmail.com"
        class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
      >
        Email
      </a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const status = document.getElementById("form-status") as HTMLParagraphElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const botcheck = form.querySelector<HTMLInputElement>('[name="botcheck"]');
    if (botcheck?.checked) return;

    btn.disabled = true;
    btn.textContent = "Sending...";
    status.classList.add("hidden");

    const data = {
      name: (form.querySelector("#name") as HTMLInputElement).value,
      email: (form.querySelector("#email") as HTMLInputElement).value,
      message: (form.querySelector("#message") as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        status.textContent = "Message sent. I'll get back to you soon.";
        status.className = "text-sm text-green-700";
        form.reset();
      } else {
        const err = await res.json();
        status.textContent = err.error || "Something went wrong. Try again.";
        status.className = "text-sm text-red-600";
      }
    } catch {
      status.textContent = "Network error. Please try again.";
      status.className = "text-sm text-red-600";
    }

    btn.disabled = false;
    btn.textContent = "Send message";
  });
</script>
